---
const projects = [
  {
    title: "Web Mond Beauty Barber",
    category: "Diseño web",
    image: "/Images/MondPamplona/MondPamplona.jpg",
    link: "/mond-pamplona",
    featured: true,
  },
  {
    title: "Caso de estudio: Refugio de animales",
    category: "Identidad · Caso de estudio",
    image: "/Images/refugio.svg",
    link: "/refugio-animales",
  },
  {
    title: "Caso de estudio: Estética y Barbería",
    category: "APP de estética",
    image: "/Images/proyecto_3.png",
    link: "/app-estetica",
  },
  {
    title: "Flyer para estética y barbería",
    category: "Campaña · Publicidad",
    image: "/Images/App estetica/flyer.png",
    link: "/publicidad-estetica",
  },
  {
    title: "Marketing Digital",
    category: "Dirección de arte · Redes sociales",
    image: "/Images/Marketing.png",
    link: "/publicidad-redes-sociales",
  },
];
---

<section class="work" aria-labelledby="work-title">
  <div class="work-inner">
    <header class="work-heading">
      <div>
        <p class="work-kicker"><span></span> Selección de trabajos</p>
        <h2 id="work-title">Proyectos<span class="work-period">.</span></h2>
      </div>
      <p class="work-intro">Una selección de ideas convertidas<br />en experiencias visuales.</p>
    </header>

    <div class="work-grid">
      {projects.map((project, index) => (
        <article
          class:list={["work-card", { "work-card--featured": project.featured }]}
        >
          <div class="work-image">
            <a class="work-image-link" href={project.link} aria-label={`Ver caso: ${project.title}`}>
              <img
                src={project.image}
                alt={`Proyecto: ${project.title}`}
                loading={index === 0 ? "eager" : "lazy"}
                draggable="false"
              />
            </a>
            <span class="work-number">{String(index + 1).padStart(2, "0")}</span>
            <a class="work-arrow" href={project.link} aria-label={`Ver caso: ${project.title}`}>↗</a>
          </div>
          <div class="work-caption">
            <div>
              {project.featured && <p class="work-feature-kicker">Experiencia digital · Mond Beauty &amp; Barber</p>}
              <p class="work-category">{project.category}</p>
              <h3>{project.title}</h3>
              {project.featured && (
                <p class="work-feature-description">
                  Diseño web para una marca de belleza y barbería. Explora el proyecto completo.
                </p>
              )}
            </div>
            <div class="work-actions">
              <a class="work-view" href={project.link}>Ver caso <span aria-hidden="true">↗</span></a>
              {project.featured && (
                <a class="work-view work-view--external" href="https://www.mondpamplona.es/" target="_blank" rel="noopener noreferrer">
                  Visitar web <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="work-end"><span>Diseño gráfico · UX/UI</span><span>Experiencias visuales ✳</span></div>
  </div>
</section>

<style>
  .work {
    --work-paper: #f4f1eb;
    --work-ink: #20211f;
    --work-muted: #77766f;
    --work-line: #d9d5cb;
    --work-accent: #eb623b;
    width: 100%;
    padding: clamp(4.5rem, 9vw, 8rem) 1.5rem clamp(3rem, 6vw, 5rem);
    color: var(--work-ink);
    background: var(--work-paper);
    font-family: "DM Sans", "Helvetica Neue", Arial, sans-serif;
  }

  .work-inner { width: min(1200px, 80%); margin-inline: auto; }
  .work-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--work-ink);
    margin-bottom: 2rem;
  }
  .work-kicker, .work-category, .work-end, .work-view {
    font-size: .7rem;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .work-kicker { display: flex; align-items: center; gap: .65rem; margin: 0 0 1rem; color: var(--work-muted); }
  .work-kicker span { width: .48rem; height: .48rem; border-radius: 50%; background: #80956b; }
  .work-heading h2 {
    margin: 0;
    font: 500 clamp(3rem, 8vw, 3rem)/.9 "Manrope", "Helvetica Neue", Arial, sans-serif;
    letter-spacing: -.03em;
  }
  .work-period { color: var(--work-accent); }
  .work-intro { margin: 0 0 .15rem; color: var(--work-muted); font-size: .9rem; line-height: 1.6; }

  .work-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3.25rem 1.5rem; }
  .work-card { display: block; min-width: 0; color: inherit; text-decoration: none; border-radius: 1rem; }
  .work-card--featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(260px, .8fr);
    background: #29372f;
    color: #f4f1eb;
    overflow: hidden;
  }

  .work-image {
    position: relative;
    height: clamp(250px, 34vw, 440px);
    overflow: hidden;
    background: #e4e0d8;
    isolation: isolate;
    border-radius: 1rem;
    clip-path: inset(0 round 1rem);
  }
  .work-card--featured .work-image {
    height: auto;
  min-height: clamp(330px, 43vw, 530px);
  background: #d7d9ce;
  border-radius: 0;
  clip-path: none;
  }
  .work-image-link { display: block; width: 100%; height: 100%; }
  .work-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform .65s ease;
    will-change: transform;
    backface-visibility: hidden;
  }

  .work-card--featured .work-caption {
    flex-direction: column; align-items: start; justify-content: space-between;
    padding: clamp(1.5rem, 4vw, 3.5rem);
  }
  .work-feature-kicker { margin: 0 0 2rem; color: #bfc5b7; font-size: .65rem; letter-spacing: .12em; text-transform: uppercase; }
  .work-card--featured .work-category { color: #c6a77e; }
  .work-card--featured .work-caption h3 { font-size: clamp(1.8rem, 3vw, 3rem); }
  .work-feature-description { max-width: 20rem; color: #d1d5cc; font-size: .88rem; line-height: 1.7; margin: 1rem 0 0; }
  .work-card--featured .work-view { color: #f4f1eb; }
  .work-actions { display: flex; flex-direction: column; align-items: flex-start; gap: .9rem; padding-top: 2rem; }
  .work-view { display: inline-flex; align-items: center; gap: .4rem; text-decoration: none; }
  .work-view--external { color: #d9b68d; }
  /*.work-view:hover { text-decoration: underline; text-underline-offset: .25em; }*/

  .work-number {
    position: absolute; z-index: 1; left: 1.5rem; top: 1.4rem;
    color: white; font-size: .7rem; letter-spacing: .1em;
    text-shadow: 0 1px 6px rgb(0 0 0 / 45%);
  }
  .work-arrow {
    position: absolute; z-index: 1; top: 1rem; right: 1rem;
    display: grid; width: 2.8rem; aspect-ratio: 1; place-items: center;
    border-radius: 50%; color: var(--work-ink); background: var(--work-paper);
    font-size: 1.2rem; transition: transform .25s ease, color .25s ease, background .25s ease;
  }

  .work-caption { display: flex; justify-content: space-between; align-items: end; gap: 1rem; padding-top: 1rem; }
  .work-category { margin: 0 0 .45rem; color: var(--work-muted); font-size: .64rem; }
  .work-caption h3 { margin: 0; font: 600 clamp(1.1rem, 2vw, 1.45rem)/1.25 "Manrope", "Helvetica Neue", Arial, sans-serif; letter-spacing: -.04em; }
  .work-view { flex: 0 0 auto; color: var(--work-muted); font-size: .62rem; transition: color .2s; }
  .work-view span { color: var(--work-accent); font-size: .9rem; }

  /* Hover solo con ratón (evita el hover "pegado" en móvil/tablet) */
  @media (hover: hover) {
    .work-card:hover .work-image img { transform: scale(1.035); }
    .work-card:hover .work-arrow { transform: rotate(45deg); color: white; background: var(--work-accent); }
    .work-card:hover .work-view { color: var(--work-ink); }
    .work-card--featured:hover .work-view { color: #f4f1eb; }
  }

  /* Foco con teclado */
  .work-card:focus-within { outline: 2px solid var(--work-accent); outline-offset: 4px; }
  .work-card:focus-within .work-image img { transform: scale(1.035); }
  .work-card:focus-within .work-arrow { transform: rotate(45deg); color: white; background: var(--work-accent); }

  .work-end { display: flex; justify-content: space-between; padding-top: 1.2rem; margin-top: 4rem; border-top: 1px solid var(--work-line); color: var(--work-muted); font-size: .62rem; }

  @media (prefers-reduced-motion: reduce) {
    .work-image img, .work-arrow, .work-view { transition: none; }
  }

  @media (max-width: 900px) {
    .work-card--featured { grid-template-columns: 1fr; }
    .work-card--featured .work-image { height: 70vw; max-height: 430px; }
    .work-card--featured .work-caption { min-height: 230px; }
  }

  @media (max-width: 640px) {
    .work { padding-inline: 1.1rem; }
    .work-heading { align-items: start; flex-direction: column; gap: 1rem; margin-bottom: 1.35rem; }
    .work-intro br { display: none; }
    .work-grid { grid-template-columns: 1fr; gap: 2rem; }
    .work-card--featured .work-image { height: 84vw; }
    .work-card--featured .work-caption { padding: 1.5rem; }
    .work-feature-kicker { margin-bottom: 1.4rem; }
    .work-card--featured .work-view { padding-top: 1.5rem; }
    .work-image { height: 84vw; max-height: 430px; }
    .work-caption { align-items: start; }
    .work-view { padding-top: 1.3rem; }
    .work-end { margin-top: 2.5rem; }
  }
</style>